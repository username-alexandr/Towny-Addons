        {
          "id": "chronicles",
          "type": "button",
          "text": "История города",
          "action": "addons:chronicles",
          "icon": "minecraft:book",
          "tooltip": "Летопись событий и решений вашего города.",
          "directoryId": "button:adventures/chronicles"
        }
      ]
    },
    {
      "id": "home",
      "type": "button",
      "text": "Главное меню",
      "action": "hub:hub",
      "x": 18,
      "y": 365,
      "w": 180,
      "h": 28,
      "tooltip": "Вернуться к основным разделам."
    }
