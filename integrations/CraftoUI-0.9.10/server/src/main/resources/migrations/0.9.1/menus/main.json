{
  "id": "main",
  "title": "Главное меню",
  "theme": "dark",
  "width": 620,
  "height": 337,
  "footer": "Поиск — разделы и избранное. Esc — закрыть.",
  "components": [
    {
      "id": "player",
      "type": "panel",
      "x": 18,
      "y": 65,
      "w": 152,
      "h": 228,
      "children": [
        {
          "id": "skin",
          "type": "avatar",
          "mode": "model",
          "x": 26,
          "y": 8,
          "w": 100,
          "h": 128
        },
        {
          "id": "name",
          "type": "text",
          "x": 12,
          "y": 148,
          "w": 128,
          "h": 16,
          "text": "${player.name}"
        },
        {
          "id": "status",
          "type": "text",
          "x": 12,
          "y": 174,
          "w": 128,
          "h": 16,
          "text": "● ${player.status}",
          "color": "accent"
        },
        {
          "id": "level",
          "type": "text",
          "x": 12,
          "y": 199,
          "w": 128,
          "h": 14,
          "text": "Уровень ${player.level}"
        },
        {
          "id": "xp",
          "type": "progress",
          "x": 12,
          "y": 218,
          "w": 128,
          "h": 4,
          "value": "${player.exp}"
        }
      ],
      "layoutRole": "aside"
    },
    {
      "id": "sections",
      "type": "grid",
      "x": 186,
      "y": 65,
      "w": 416,
      "h": 258,
      "columns": 2,
      "gap": 6,
      "rowHeight": 38,
      "children": [
        {
          "id": "orders",
          "type": "button",
          "text": "Личные заказы",
          "action": "quick:orders",
          "icon": "minecraft:paper",
          "tooltip": "Открыть доску /orders: выбрать заказ и заработать лично."
        },
        {
          "id": "economy",
          "type": "button",
          "text": "Работа и торговля",
          "action": "hub:economy",
          "icon": "minecraft:emerald",
          "tooltip": "Профессии, рынок, поставки, компании и городские контракты."
        },
        {
          "id": "create-town",
          "type": "button",
          "text": "Создать город",
          "action": "ui:create-town",
          "icon": "minecraft:oak_door",
          "tooltip": "Введите название. Towny проверит место, права и стоимость создания.",
          "requiresNoTown": true,
          "directoryId": "button:hub/create-town"
        },
        {
          "id": "town",
          "type": "button",
          "text": "Мой город",
          "action": "hub:town",
          "icon": "minecraft:bricks",
          "tooltip": "Сводка, склад, постройки, казна и развитие."
        },
        {
          "id": "adventures",
          "type": "button",
          "text": "Задания и события",
          "action": "hub:adventures",
          "icon": "minecraft:compass",
          "tooltip": "Городские задания, экспедиции, события и достижения."
        },
        {
          "id": "society",
          "type": "button",
          "text": "Жители и власть",
          "action": "hub:society",
          "icon": "minecraft:lectern",
          "tooltip": "Гражданство, совет, министры, законы и безопасность."
        },
        {
          "id": "commands",
          "type": "button",
          "text": "Все команды",
          "action": "commands",
          "icon": "minecraft:writable_book",
          "tooltip": "Действия аддонов и команды с полями ввода."
        },
        {
          "id": "profile",
          "type": "button",
          "text": "Мой профиль",
          "action": "profile",
          "icon": "minecraft:player_head",
          "tooltip": "Данные вашего персонажа."
        },
        {
          "id": "help",
          "type": "button",
          "text": "Помощь",
          "action": "help",
          "icon": "minecraft:book",
          "tooltip": "Где искать заказы, склад и назначения."
        },
        {
          "id": "settings",
          "type": "button",
          "text": "Настройки",
          "action": "settings",
          "icon": "minecraft:comparator",
          "tooltip": "Внешний вид и управление интерфейсом."
        },
        {
          "id": "management",
          "type": "button",
          "text": "Администрация",
          "action": "hub:management",
          "permission": "craftoui.admin.menus",
          "hideWhenDenied": true
        }
      ],
      "layoutRole": "content"
    }
  ],
  "searchable": false,
  "responsive": true
}
