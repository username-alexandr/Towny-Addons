{
  "id": "profile",
  "title": "Профиль",
  "theme": "classic",
  "width": 560,
  "height": 460,
  "permission": "craftoui.profile",
  "footer": "Данные персонажа на текущем сервере",
  "components": [
    {
      "id": "portrait",
      "type": "panel",
      "x": 16,
      "y": 58,
      "w": 150,
      "h": 300,
      "children": [
        {
          "id": "skin",
          "type": "avatar",
          "x": 12,
          "y": 12,
          "w": 126,
          "h": 240,
          "mode": "model"
        },
        {
          "id": "nick",
          "type": "text",
          "x": 10,
          "y": 268,
          "w": 130,
          "h": 18,
          "text": "${player.name}"
        }
      ]
    },
    {
      "id": "stats",
      "type": "list",
      "x": 180,
      "y": 58,
      "w": 364,
      "h": 300,
      "rowHeight": 38,
      "gap": 6,
      "children": [
        {
          "id": "s0",
          "type": "text",
          "x": 0,
          "y": 0,
          "w": 0,
          "h": 0,
          "text": "Статус: ${player.status}"
        },
        {
          "id": "s1",
          "type": "text",
          "x": 0,
          "y": 0,
          "w": 0,
          "h": 0,
          "text": "Уровень опыта: ${player.level}"
        },
        {
          "id": "s2",
          "type": "text",
          "x": 0,
          "y": 0,
          "w": 0,
          "h": 0,
          "text": "Здоровье: ${player.health}"
        },
        {
          "id": "s3",
          "type": "text",
          "x": 0,
          "y": 0,
          "w": 0,
          "h": 0,
          "text": "Сытость: ${player.food}"
        },
        {
          "id": "s4",
          "type": "text",
          "x": 0,
          "y": 0,
          "w": 0,
          "h": 0,
          "text": "Мир: ${player.world}"
        },
        {
          "id": "s5",
          "type": "text",
          "x": 0,
          "y": 0,
          "w": 0,
          "h": 0,
          "text": "Режим: ${player.gamemode}"
        },
        {
          "id": "s6",
          "type": "text",
          "x": 0,
          "y": 0,
          "w": 0,
          "h": 0,
          "text": "Группа: ${player.group}"
        }
      ]
    },
    {
      "id": "back",
      "type": "button",
      "x": 16,
      "y": 378,
      "w": 250,
      "h": 30,
      "text": "Назад",
      "action": "main"
    },
    {
      "id": "refresh",
      "type": "button",
      "x": 280,
      "y": 378,
      "w": 264,
      "h": 30,
      "text": "Обновить данные",
      "action": "refresh"
    }
  ]
}
