+package ru.neverland.passport.integration;
+
+import java.util.Map;
+import java.util.UUID;
+import org.bukkit.Bukkit;
+import ru.neverland.core.ApiServices;
+import ru.neverland.passport.model.Passport;
+
+/** Display overlay: SQLite identity/document state is never replaced with computed citizenship. */
+public final class CitizensBridge {
+    private CitizensBridge() { }
+    public static boolean managed() { return Bukkit.getPluginManager().getPlugin("NeverLandTownyCitizens") != null; }
+    public static String citizenship(Passport passport) { return value(passport, "citizenship"); }
+    public static String value(Passport passport, String key) {
+        if (!Bukkit.isPrimaryThread()) return "Недоступно";
+        if (!managed()) return key.equals("citizenship") ? passport.getCitizenship() : "";
+        var connection = ApiServices.connect("NeverLandTownyCitizens", "ru.neverland.townycitizens.api.TownyCitizensApi", 1, "passport");
+        if (!connection.ready()) return "Недоступно";
+        try {
+            Object fields = connection.invoke("passport", new Class<?>[]{UUID.class}, passport.getOwnerUuid());
+            if (fields instanceof Map<?, ?> map && map.get(key) instanceof String text) return text;
+        } catch (ReflectiveOperationException | RuntimeException | LinkageError ex) { return "Недоступно"; }
+        return "Недоступно";
+    }
+    public static String[] lore(Passport passport, String oldHint) {
+        if (!managed()) return new String[]{oldHint};
+        return new String[]{"&7Город: &f" + value(passport, "citizenship_town_name"),
+                "&7Срок проживания: &f" + value(passport, "citizenship_expires"),
+                "&7Налог: &f×" + value(passport, "citizenship_tax_multiplier"),
+                "&7Право голоса: &f" + value(passport, "citizenship_vote"), "", "&eСтатус назначается через /t citizens set"};
+    }
+}
